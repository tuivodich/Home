rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : 'none';
    }
    function isAdmin() { return signedIn() && role() in ['owner', 'manager']; }
    function isStaff() { return signedIn() && role() in ['owner', 'manager', 'reception', 'housekeeping', 'security']; }
    function isOwner() { return signedIn() && role() == 'owner'; }
    // Số yêu cầu đặt phòng đang chờ xác nhận tối đa mỗi tài khoản (chủ/quản lý chỉnh ở Cài đặt; mặc định 3).
    function maxPending() {
      return exists(/databases/$(database)/documents/settings/app)
        ? get(/databases/$(database)/documents/settings/app).data.get('maxPending', 3) : 3;
    }
    function isFront() { return signedIn() && role() in ['owner', 'manager', 'reception']; }

    // Người đầu tiên đăng nhập (chưa có meta/bootstrap) trở thành chủ homestay.
    match /meta/bootstrap {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Mọi người tự đăng ký đều là khách hàng; nhân viên do chủ cấp quyền sau.
      allow create: if signedIn() && request.auth.uid == uid && (
        request.resource.data.role == 'customer' ||
        (request.resource.data.role == 'owner' &&
          !exists(/databases/$(database)/documents/meta/bootstrap) &&
          getAfter(/databases/$(database)/documents/meta/bootstrap).data.uid == uid));
      // Chủ: đổi/xóa vai trò của bất kỳ ai khác mình. Quản lý: chỉ chỉnh các vai trò dưới quản lý
      // (lễ tân, buồng phòng, bảo vệ, khách) — không cấp "Chủ"/"Quản lý" và không đụng tài khoản Chủ/Quản lý.
      allow update, delete: if isAdmin() && uid != request.auth.uid && (
        role() == 'owner' ||
        (!(resource.data.role in ['owner', 'manager']) && (request.method == 'delete' || !(request.resource.data.role in ['owner', 'manager']))));
    }

    // Công khai: tên phòng, giá, tỷ giá — không chứa dữ liệu cá nhân.
    // Cài đặt chung (tỷ giá, giao diện website…): ai cũng đọc, chỉ chủ/quản lý ghi.
    // Giao diện: chỉ nhận các mã hợp lệ, hiệu ứng / tự động theo mùa là true/false.
    match /settings/{id} {
      allow read: if !(id in ['bank', 'mail', 'mailState']);
      allow write: if isAdmin() && !(id in ['contact', 'pricing', 'booking', 'bank', 'loyalty', 'backup', 'backupStatus', 'mail', 'mailState'])
        && (!('theme' in request.resource.data) || request.resource.data.theme in ['night', 'mist', 'dusk', 'noel'])
        && (!('themeAuto' in request.resource.data) || request.resource.data.themeAuto is bool)
        && (!('effects' in request.resource.data) || request.resource.data.effects is bool)
        && (!('maxPending' in request.resource.data) || (request.resource.data.maxPending is int && request.resource.data.maxPending >= 1 && request.resource.data.maxPending <= 20));
    }
    // Thông tin liên hệ công khai (website + bot Telegram): chuỗi ngắn; đường dẫn chỉ nhận http(s) để không chèn được javascript:.
    match /settings/contact {
      function okText(d, k) { return !(k in d) || (d[k] is string && d[k].size() <= 300); }
      function okUrl(d, k) { return !(k in d) || (d[k] is string && d[k].size() <= 300 && (d[k] == '' || d[k].matches('^https?://[^ ]+$'))); }
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['phone', 'zalo', 'email', 'address', 'facebook', 'mapUrl', 'coords'])
        && okText(request.resource.data, 'phone') && okText(request.resource.data, 'zalo')
        && okText(request.resource.data, 'email') && okText(request.resource.data, 'address') && okText(request.resource.data, 'coords')
        && okUrl(request.resource.data, 'facebook') && okUrl(request.resource.data, 'mapUrl');
    }
    // Email gửi khách: chủ bật/tắt; chủ và quản lý xem. mailState do Cloud Functions ghi.
    match /settings/mail {
      allow read: if isAdmin();
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['enabled', 'fromName', 'replyTo'])
        && request.resource.data.enabled is bool
        && (!('fromName' in request.resource.data) || (request.resource.data.fromName is string && request.resource.data.fromName.size() <= 60))
        && (!('replyTo' in request.resource.data) || (request.resource.data.replyTo is string && request.resource.data.replyTo.size() <= 200));
    }
    match /settings/mailState {
      allow read, write: if false;
    }
    // Bảng giá (cuối tuần, mùa, lễ, ở dài ngày): ai cũng đọc để tính giá; chủ/quản lý sửa.
    match /settings/pricing {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['weekendDays', 'weekendPercent', 'seasons', 'holidays', 'longStay'])
        && request.resource.data.weekendDays is list && request.resource.data.weekendDays.size() <= 7
        && request.resource.data.weekendPercent is number && request.resource.data.weekendPercent >= -50 && request.resource.data.weekendPercent <= 300
        && request.resource.data.seasons is list && request.resource.data.seasons.size() <= 20
        && request.resource.data.holidays is list && request.resource.data.holidays.size() <= 40
        && request.resource.data.longStay is list && request.resource.data.longStay.size() <= 10;
    }
    // Đặt cọc, giờ nhận/trả phòng, chính sách hủy, phụ thu, dịch vụ đi kèm: công khai để hiển thị khi đặt; chủ/quản lý sửa.
    match /settings/booking {
      function okFee(d, k) { return !(k in d) || (d[k] is number && d[k] >= 0 && d[k] <= 100000000); }
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['depositPercent', 'checkInTime', 'checkOutTime', 'cancelTiers', 'cancelNote', 'extraGuestFee', 'earlyCheckInFee', 'lateCheckOutFee', 'services'])
        && request.resource.data.depositPercent is number && request.resource.data.depositPercent >= 0 && request.resource.data.depositPercent <= 100
        && request.resource.data.checkInTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.checkOutTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.cancelTiers is list && request.resource.data.cancelTiers.size() <= 10
        && request.resource.data.cancelNote is string && request.resource.data.cancelNote.size() <= 1000
        && okFee(request.resource.data, 'extraGuestFee') && okFee(request.resource.data, 'earlyCheckInFee') && okFee(request.resource.data, 'lateCheckOutFee')
        && request.resource.data.services is list && request.resource.data.services.size() <= 30;
    }
    // Tài khoản nhận cọc: chỉ người đã đăng nhập đọc (để hiện mã QR khi đặt phòng); CHỈ CHỦ được thiết lập.
    match /settings/bank {
      allow read: if signedIn();
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['bankBin', 'bankName', 'accountNo', 'accountName'])
        && request.resource.data.bankBin.matches('^[0-9]{6}$')
        && request.resource.data.bankName is string && request.resource.data.bankName.size() <= 80
        && request.resource.data.accountNo.matches('^[0-9A-Za-z]{4,30}$')
        && request.resource.data.accountName is string && request.resource.data.accountName.size() >= 1 && request.resource.data.accountName.size() <= 80;
    }
    // Thành viên thân thiết: cấu hình hạng (công khai để hiện tiến độ), chủ/quản lý sửa.
    match /settings/loyalty {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'tiers'])
        && request.resource.data.enabled is bool
        && request.resource.data.tiers is list && request.resource.data.tiers.size() <= 10;
    }
    // Cấu hình sao lưu tự động (chỉ chủ/quản lý đọc; kết quả lần chạy do Cloud Functions ghi).
    match /settings/backup {
      allow read: if isAdmin();
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['enabled', 'frequency', 'keep'])
        && request.resource.data.enabled is bool
        && request.resource.data.frequency in ['daily', 'weekly']
        && request.resource.data.keep is int && request.resource.data.keep >= 1 && request.resource.data.keep <= 60;
    }
    // Kết quả lần sao lưu gần nhất do Cloud Functions ghi (chủ/quản lý đọc).
    match /settings/backupStatus {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /rooms/{id} {
      function okRoom(d) {
        return d.keys().hasOnly(['name', 'type', 'capacity', 'baseGuests', 'price', 'status', 'photos', 'desc', 'descEn', 'features', 'featuresEn'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 100
          && d.type in ['wood', 'concrete'] && d.status in ['active', 'maintenance']
          && d.capacity is number && d.price is number && d.price >= 0
          && (!('photos' in d) || (d.photos is list && d.photos.size() <= 8))
          && (!('desc' in d) || (d.desc is string && d.desc.size() <= 3000))
          && (!('descEn' in d) || (d.descEn is string && d.descEn.size() <= 3000))
          && (!('features' in d) || (d.features is string && d.features.size() <= 1500))
          && (!('featuresEn' in d) || (d.featuresEn is string && d.featuresEn.size() <= 1500));
      }
      allow read: if true;
      allow create, update: if isAdmin() && okRoom(request.resource.data);
      allow delete: if isAdmin();
    }

    // Lịch bận công khai: chỉ phòng + ngày + trạng thái, KHÔNG có tên/điện thoại khách.
    // Mỗi đặt phòng có một bản sao cùng id.
    match /busy/{id} {
      allow read: if true;
      allow create: if signedIn() && (isFront() || (
        getAfter(/databases/$(database)/documents/bookings/$(id)).data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['roomId', 'checkIn', 'checkOut', 'status'])
        && request.resource.data.status == 'pending'
        && request.resource.data.roomId == getAfter(/databases/$(database)/documents/bookings/$(id)).data.roomId
        && request.resource.data.checkIn == getAfter(/databases/$(database)/documents/bookings/$(id)).data.checkIn
        && request.resource.data.checkOut == getAfter(/databases/$(database)/documents/bookings/$(id)).data.checkOut));
      allow update: if isFront();
      // Khách được gỡ lịch bận của chính đặt phòng mình tạo (khi tự hủy).
      allow delete: if isFront() || (signedIn()
        && exists(/databases/$(database)/documents/bookings/$(id))
        && get(/databases/$(database)/documents/bookings/$(id)).data.createdBy == request.auth.uid);
    }

    match /bookings/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if isFront() || (signedIn()
        && request.resource.data.keys().hasOnly(['roomId', 'guestName', 'phone', 'email', 'checkIn', 'checkOut',
                                                  'guests', 'total', 'status', 'note', 'source', 'createdBy',
                                                  'couponCode', 'discountPercent', 'originalTotal', 'slotId', 'lines', 'deposit', 'code', 'opts'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.source == 'online'
        && request.resource.data.checkIn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.checkOut.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.checkIn < request.resource.data.checkOut
        && request.resource.data.guestName is string && request.resource.data.guestName.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.guests is int && request.resource.data.guests >= 1 && request.resource.data.guests <= 30
        && request.resource.data.total is number
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && (!('code' in request.resource.data) || (request.resource.data.code is string && request.resource.data.code.matches('^[A-Z0-9]{1,12}$')))
        && (!('opts' in request.resource.data) || request.resource.data.opts is map)
        && (!('lines' in request.resource.data) || (request.resource.data.lines is list && request.resource.data.lines.size() <= 30))
        && (!('deposit' in request.resource.data) || (request.resource.data.deposit is number && request.resource.data.deposit >= 0 && request.resource.data.deposit <= request.resource.data.total))
        // Mỗi yêu cầu phải chiếm một khe giữ chỗ của chính khách (tối đa maxPending khe) được tạo cùng lần ghi.
        && request.resource.data.slotId is string
        && getAfter(/databases/$(database)/documents/pend/$(request.resource.data.slotId)).data.bookingId == id
        && getAfter(/databases/$(database)/documents/pend/$(request.resource.data.slotId)).data.uid == request.auth.uid
        // Giảm giá chỉ hợp lệ khi mã vừa được dùng trong CÙNG lần ghi, thuộc về chính khách này, đúng phần trăm.
        && (!('couponCode' in request.resource.data) || (
              getAfter(/databases/$(database)/documents/coupons/$(request.resource.data.couponCode)).data.used == true
              && getAfter(/databases/$(database)/documents/coupons/$(request.resource.data.couponCode)).data.usedBy == request.auth.uid
              && getAfter(/databases/$(database)/documents/coupons/$(request.resource.data.couponCode)).data.bookingId == id
              && request.resource.data.discountPercent == getAfter(/databases/$(database)/documents/coupons/$(request.resource.data.couponCode)).data.percent
              && request.resource.data.originalTotal is number))
        && (!('discountPercent' in request.resource.data) || 'couponCode' in request.resource.data)
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)));
      // Đặt phòng đã trả phòng / đã hủy chỉ CHỦ mới được sửa lại (hoàn tác trả phòng, khôi phục): quản lý, lễ tân thì không.
      // Khách tự hủy đặt phòng ONLINE của mình khi còn "chờ xác nhận" hoặc "đã xác nhận" (chưa nhận phòng);
      // chỉ được đổi trạng thái sang "cancelled" (kèm lý do "customer" nếu có).
      // Lễ tân chỉ đổi được trạng thái; giá và mã giảm giá chỉ chủ/quản lý sửa được.
      allow update: if isOwner()
        // Ghi nhận tiền đã thu / hoàn (cọc, thu thêm) ở mọi trạng thái: chủ, quản lý, lễ tân.
        || (isFront() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid', 'payLog']))
        || (!(resource.data.status in ['checked_out', 'cancelled']) && (isAdmin()
          || (isFront() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelReason']))
          || (signedIn()
            && resource.data.createdBy == request.auth.uid
            && resource.data.source == 'online'
            && resource.data.status in ['pending', 'confirmed']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelReason', 'cancelledAt'])
            && (!('cancelReason' in request.resource.data) || request.resource.data.cancelReason == 'customer')
            && (!('cancelledAt' in request.resource.data) || request.resource.data.cancelledAt == request.time))));
      allow delete: if isAdmin();
    }

    // Khe giữ chỗ giới hạn số yêu cầu đang chờ xác nhận mỗi tài khoản: id = uid_n với 1 ≤ n ≤ maxPending.
    // Khách chỉ tạo được khe (không sửa) cùng với đặt phòng; chỉ nhả được khi đặt phòng đó không còn "chờ xác nhận" (vd. tự hủy).
    match /pend/{slotId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isFront());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'n', 'bookingId'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= maxPending()
        && slotId == request.auth.uid + '_' + string(request.resource.data.n)
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.slotId == slotId
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.createdBy == request.auth.uid;
      allow delete: if isFront() || (signedIn() && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status != 'pending');
    }

    // Mã giảm giá dùng 1 lần do chủ/quản lý tạo. Khách chỉ được xem MỘT mã khi biết đúng mã (không liệt kê được).
    match /coupons/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn()
        // Mã riêng của thành viên (ownerUid) chỉ chủ mã dùng được.
        && (!('ownerUid' in resource.data) || resource.data.ownerUid == request.auth.uid)
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt', 'bookingId'])
        && request.resource.data.usedBy == request.auth.uid
        && (!('expiresAt' in resource.data) || resource.data.expiresAt > request.time)
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.couponCode == code
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.discountPercent == resource.data.percent);
    }

    // Nội dung các trang (Chính sách quyền riêng tư, Hỏi & Đáp): ai cũng đọc, chỉ chủ/quản lý sửa.
    match /pages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cảm nhận của khách: mỗi tài khoản một cảm nhận (id = uid). Chỉ hiện công khai khi chủ/quản lý duyệt.
    // Khách sửa cảm nhận của mình thì quay lại "pending" để duyệt lại.
    match /reviews/{uid} {
      function okReview(d) {
        return d.name is string && d.name.size() >= 1 && d.name.size() <= 80
          && d.rating is int && d.rating >= 1 && d.rating <= 5
          && d.comment is string && d.comment.size() >= 10 && d.comment.size() <= 600;
      }
      allow get: if (signedIn() && request.auth.uid == uid) || isAdmin() || resource.data.status == 'approved';
      allow list: if isAdmin() || resource.data.status == 'approved' || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'rating', 'comment', 'status', 'createdBy', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && okReview(request.resource.data);
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['pending', 'approved', 'rejected'])
        // Chỉ Chủ được sửa nội dung cảm nhận (kể cả đã duyệt); trạng thái giữ nguyên.
        || (isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'rating', 'comment'])
          && okReview(request.resource.data))
        || (signedIn() && resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'rating', 'comment', 'status'])
          && okReview(request.resource.data));
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    // Bot Telegram: danh sách chat đã liên kết (chủ/quản lý xem và gỡ). Mã liên kết, nhật ký gửi và ghi dữ liệu do Cloud Functions
    // (Admin SDK, bỏ qua luật) đảm nhiệm nên khách/nhân viên không đọc hay ghi trực tiếp được.
    match /tgChats/{chatId} {
      allow read, delete: if isAdmin();
    }

    // ===== Ca làm & chấm công nhân viên =====
    // Danh mục ca (vd. Ca sáng 06:00–14:00): nhân viên xem, chủ/quản lý sửa.
    match /shifts/{id} {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'start', 'end', 'active'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.active is bool;
    }
    // Lịch ca: mỗi nhân viên một ca mỗi ngày, id = yyyy-mm-dd_uid. Nhân viên xem, chủ/quản lý xếp.
    match /schedule/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['date', 'uid', 'name', 'shiftId'])
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.uid is string && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.shiftId is string
        && id == request.resource.data.date + '_' + request.resource.data.uid;
      allow delete: if isAdmin();
    }
    // Chấm công: nhân viên tự vào ca (giờ = giờ máy chủ, không lùi giờ được) và ra ca (một lần); chủ/quản lý chỉnh sửa/bổ sung.
    match /attendance/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() || (isStaff()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'date', 'in', 'source'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.source == 'self'
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data['in'] == request.time);
      allow update: if isAdmin() || (isStaff()
        && resource.data.uid == request.auth.uid && !('out' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['out'])
        && request.resource.data.out == request.time);
      allow delete: if isAdmin();
    }

    // Hồ sơ cá nhân của từng tài khoản (dùng điền sẵn khi đặt phòng): chính chủ sửa được; CHỈ CHỦ sửa được hồ sơ của người khác.
    // Chủ/quản lý/lễ tân xem được để hỗ trợ khách.
    match /profiles/{uid} {
      function okProfile(d) {
        return d.keys().hasOnly(['fullName', 'docType', 'docNumber', 'nationality', 'dob', 'phone', 'email', 'updatedAt'])
          && d.fullName is string && d.fullName.size() <= 100
          && d.docType in ['cccd', 'passport', 'license', 'other']
          && d.docNumber is string && d.docNumber.size() <= 30
          && d.nationality is string && d.nationality.size() <= 60
          && d.dob is string && d.dob.size() <= 10
          && d.phone is string && d.phone.size() <= 30
          && d.email is string && d.email.size() <= 200;
      }
      allow read: if signedIn() && (request.auth.uid == uid || isFront());
      allow create, update: if signedIn() && (request.auth.uid == uid || isOwner()) && okProfile(request.resource.data);
      allow delete: if isOwner();
    }

    // Check-in online: khách điền trước họ tên, giấy tờ, giờ đến dự kiến cho đặt phòng của mình (id = mã đặt phòng);
    // nhân viên chuyển thành hồ sơ "Khách lưu trú" rồi đánh dấu "imported".
    match /precheckins/{bid} {
      function okPre(d) {
        return d.keys().hasOnly(['uid', 'bookingId', 'fullName', 'docType', 'docNumber', 'nationality', 'dob', 'phone', 'email', 'eta', 'note', 'status', 'updatedAt'])
          && d.bookingId == bid && d.status == 'submitted'
          && d.fullName is string && d.fullName.size() >= 1 && d.fullName.size() <= 100
          && d.docType in ['cccd', 'passport', 'license', 'other']
          && d.docNumber is string && d.docNumber.size() <= 30
          && d.nationality is string && d.nationality.size() <= 60
          && d.dob is string && d.dob.size() <= 10
          && d.phone is string && d.phone.size() <= 30
          && d.email is string && d.email.size() <= 200
          && d.eta is string && (d.eta == '' || d.eta.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
          && d.note is string && d.note.size() <= 300;
      }
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isFront());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && okPre(request.resource.data)
        && getAfter(/databases/$(database)/documents/bookings/$(bid)).data.createdBy == request.auth.uid;
      allow update: if (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'submitted'
          && request.resource.data.uid == request.auth.uid && okPre(request.resource.data)
          && get(/databases/$(database)/documents/bookings/$(bid)).data.status in ['pending', 'confirmed'])
        || (isFront() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['submitted', 'imported']);
      allow delete: if isAdmin();
    }

    // Hạng thành viên đặt tay (members/{uid}.tier); các mã ưu đãi đã nhận do Cloud Functions ghi vào `claimed`.
    // Chat Telegram của khách đã liên kết (Cloud Functions ghi); khách chỉ xem của mình.
    match /tgGuests/{chatId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isFront());
      allow write: if isOwner() && request.resource.data.keys().hasOnly(['tier', 'claimed', 'updatedAt', 'updatedBy'])
        && request.resource.data.tier is string && request.resource.data.tier.size() <= 30;
    }

    // Trạng thái buồng phòng: mọi nhân viên xem; nhân viên cập nhật (bẩn / đang dọn / sẵn sàng), chủ/quản lý xóa.
    match /roomStatus/{roomId} {
      function okRoomStatus(d) {
        return d.keys().hasOnly(['status', 'note', 'assignedTo', 'assignedName', 'updatedAt', 'updatedBy', 'updatedByName'])
          && d.status in ['ready', 'dirty', 'cleaning']
          && (!('note' in d) || (d.note is string && d.note.size() <= 300))
          && (!('assignedName' in d) || (d.assignedName is string && d.assignedName.size() <= 100));
      }
      allow read: if isStaff();
      allow create, update: if isStaff() && okRoomStatus(request.resource.data);
      allow delete: if isAdmin();
    }

    // Chi phí và công nợ phải trả: chỉ chủ/quản lý.
    match /expenses/{id} {
      function okExpense(d) {
        return d.keys().hasOnly(['date', 'category', 'amount', 'vendor', 'note', 'paid', 'dueDate', 'paidAt', 'createdBy'])
          && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.category in ['electric', 'water', 'salary', 'maintenance', 'supplies', 'food', 'marketing', 'tax', 'other']
          && d.amount is number && d.amount >= 0 && d.amount <= 10000000000
          && d.vendor is string && d.vendor.size() <= 100 && d.note is string && d.note.size() <= 300
          && d.paid is bool && (!('dueDate' in d) || d.dueDate == '' || d.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && okExpense(request.resource.data);
    }

    match /guests/{id} {
      allow read, create, update: if isFront();
      allow delete: if isAdmin();
    }
  }
}
