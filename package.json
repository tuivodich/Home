{
  "name": "nhago-homestay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:lib": "node --experimental-strip-types --test scripts/*.test.mts",
    "test:emu": "firebase emulators:exec --only firestore --project demo-test \"npm ci --prefix tests && npm ci --prefix functions && node tests/rules.test.mjs && npm test --prefix functions\"",
    "test": "npm run test:lib && npm run test:emu"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.34.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
